   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Group and sort values from highest to lowest\n",
    "base = enaho['labor'].value_counts().sort_values(ascending=False)\n",
    "\n",
    "# Plot pie chart\n",
    "base.plot(kind='pie', figsize=(8, 8), autopct='%1.1f%%', startangle=90, counterclock=False)\n",
    "\n",
    "# Title and style tweaks\n",
    "plt.title(\"Ocupaciones laborales\")\n",
    "plt.ylabel(\"\")  # Remove y-label for clean pie chart\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
