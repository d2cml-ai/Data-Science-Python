  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0, 0.5, 'Número de Observaciones')"
      ]
     },
     "execution_count": 18,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sns.set( style=\"darkgrid\" )\n",
    "# sns.set( style=\"whitegrid\" )\n",
    "#figure size\n",
    "\n",
    "fig, ax = plt.subplots( figsize=(7, 4) )\n",
    "\n",
    "x = sns.countplot( x=\"empresa\", data=enaho[enaho['year'] == \"2019\" ] )\n",
    "\n",
    "# Iterar sobre las barras\n",
    "for p in ax.patches:\n",
    "    # Obtener la posición y la altura de la barra\n",
    "    height = p.get_height()\n",
    "    # Colocar el texto sobre la barra\n",
    "    ax.text(p.get_x() + p.get_width() / 2., height + 0.1, '{}'.format(height), ha='center', va='bottom')\n",
    "    \n",
    "plt.title('Cantidad de empresas según clasificación en el 2019')\n",
    "plt.xlabel('Tipo de empresa')\n",
    "plt.ylabel('Número de Observaciones')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "###### Vertical Countplot and one color (red)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "/var/folders/k7/tnfx_2n55hd1cf9b5gv3gp640000gn/T/ipykernel_75273/2239010234.py:12: DeprecationWarning: is_categorical_dtype is deprecated and will be removed in a future version. Use isinstance(dtype, pd.CategoricalDtype) instead\n",
      "  if pd.api.types.is_categorical_dtype(enaho_copy['empresa']):\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# Make a copy of the data\n",
    "enaho_copy = enaho.copy()\n",
    "\n",
    "# Filter for 2019\n",
    "mask_2019 = enaho_copy['year'] == \"2019\"\n",
    "\n",
    "# If 'empresa' is categorical, add \"NaN\" as a valid category\n",
    "if pd.api.types.is_categorical_dtype(enaho_copy['empresa']):\n",
    "    enaho_copy['empresa'] = enaho_copy['empresa'].cat.add_categories(\"NaN\")\n",
    "\n",
    "# Fill NaNs in 'empresa' only for 2019\n",
    "enaho_copy.loc[mask_2019, 'empresa'] = enaho_copy.loc[mask_2019, 'empresa'].fillna(\"NaN\")\n",
    "\n",
    "# Set style\n",
    "sns.set(style=\"darkgrid\")\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "x = sns.countplot(x=\"empresa\", data=enaho_copy[mask_2019], ax=ax)\n",
    "\n",
    "# Format y-axis to show only integers\n",
    "ax.yaxis.set_major_locator(plt.MaxNLocator(integer=True))\n",
    "\n",
    "# Add labels\n",
    "for p in ax.patches:\n",
    "    height = int(p.get_height())\n",
    "    ax.text(p.get_x() + p.get_width() / 2., height + 0.1, f'{height}', ha='center', va='bottom')\n",
    "\n",
    "# Add titles and labels\n",
    "plt.title('Cantidad de empresas según clasificación en el 2019')\n",
    "plt.xlabel('Tipo de empresa')\n",
    "plt.ylabel('Número de Observaciones')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
