   "source": [
    "macro = pd.read_csv(r\"../_data/macroeconomia.csv\")\n",
    "macro['YEAR']  = pd.to_datetime(macro['Fecha'])\n",
    "macro"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0.5, 0.01, 'Elboración propia - BCRP')"
      ]
     },
     "execution_count": 32,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 720x360 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sns.set('notebook')\n",
    "\n",
    "sns.relplot(x=\"YEAR\", y=\"IPM\", kind=\"line\", color=\"red\", data=macro, height=5, aspect=2)\n",
    "plt.xlabel(' ')\n",
    "plt.ylabel(' ')\n",
    "plt.title('Índice del precio de materias primas 2013-2019')\n",
    "\n",
    "txt=\"Elboración propia - BCRP\"  \n",
    "plt.figtext(0.5, 0.01, txt, wrap=True, horizontalalignment='center', fontsize=12)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Series in a single image\n",
    "\n",
    "This graph shows a positive relationship between the change in international reserves and the commodity index."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 88,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0.2, 0.01, 'Elaboración propia - BCRP')"
      ]
     },
     "execution_count": 88,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 864x360 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sns.set('notebook')\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12,5))\n",
    "\n",
    "x = macro['YEAR']\n",
    "y1 = macro['DIPM']\n",
    "y2 = macro['DRIN']\n",
    "\n",
    "plt.plot(x, y1, label ='Indice de materias primas (Var %)', color='blue')\n",
    "plt.plot(x, y2, label ='Reservas internacionales (Var %)', color='red')\n",
    "plt.axhline(y=0, color='black', linestyle='--', lw=0.8)\n",
    "\n",
    "plt.legend(loc='upper right')\n",
    "\n",
    "txt=\"Elaboración propia - BCRP\"  \n",
    "plt.figtext(0.2, 0.01, txt, wrap=True, horizontalalignment='right', fontsize=10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Dual-line Plots\n",
    "\n",
    "#### Exchange rate and monetary policy reaction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 89,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Text(0.2, 0.01, 'Elboración propia - BCRP')"
      ]
     },
     "execution_count": 89,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 720x360 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sns.set('notebook', style = \"ticks\", font_scale= 1.08)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10,5))\n",
    "lineplot = sns.lineplot(x= \"YEAR\" , y= \"RATE\", data=macro, \n",
    "                        label = 'Tasa interbancaria promedio ', color=\"k\", legend=False)\n",
    "\n",
    "#sns.despine()\n",
    "plt.ylabel('Tasa de política monetaria')\n",
    "plt.xlabel(' ')\n",
    "plt.title('Exchange rate and monetary policy reaction');\n",
    "\n",
    "ax2 = ax.twinx()\n",
    "lineplot2 = sns.lineplot(x= \"YEAR\", y= \"DTC\", data=macro, ax=ax2, color = \"red\", \n",
    "                         label ='Tipo de cambio (variación anual %)', legend=False) \n",
    "sns.despine(right=False)\n",
    "plt.ylabel('Tipo de cambio')\n",
    "ax.figure.legend(loc='lower center', bbox_to_anchor=(1.1, 0.5), ncol=1);\n",
    "\n",
    "\n",
    "txt=\"Elboración propia - BCRP\"  \n",
    "plt.figtext(0.2, 0.01, txt, wrap=True, horizontalalignment='right', fontsize=10)"
   ]
  },
