   "source": [
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Create the catplot with independent y-axis per facet\n",
    "ag = sns.catplot(\n",
    "    x=\"empresa\",\n",
    "    hue=\"year\",\n",
    "    col=\"area\",\n",
    "    data=base2,\n",
    "    kind=\"count\",\n",
    "    height=10,\n",
    "    aspect=1,\n",
    "    sharey=False  # Important!\n",
    ")\n",
    "\n",
    "# Loop over axes and set custom y-limits per 'area'\n",
    "for ax in ag.axes.flat:\n",
    "    # Extract the area value from the title of each subplot\n",
    "    title_text = ax.get_title()\n",
    "    # e.g., \"area = Rural\" → \"Rural\"\n",
    "    area_value = title_text.split(\" = \")[1]\n",
    "\n",
    "    # Filter data for that area\n",
    "    area_data = base2[base2[\"area\"] == area_value]\n",
    "\n",
    "    # Count and get the max value\n",
    "    max_count = area_data.groupby([\"empresa\", \"year\"]).size().max()\n",
    "\n",
    "    # Set custom ylim with margin\n",
    "    ax.set_ylim(0, max_count * 1.1)\n",
    "\n",
    "# Label formatting\n",
    "(ag.set_axis_labels(\"Tipo de empresa\", \"Número de empresas\")\n",
    "   .despine(left=True))\n"
   ]
  },
