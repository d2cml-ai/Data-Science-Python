    "# Covid infection & postas médicas at the national level \n",
    "\n",
    "gf = base.plot(column='Casos', cmap='Oranges', \n",
    "          figsize=(30, 30),\n",
    "          linestyle='-',\n",
    "          edgecolor='black',\n",
    "          legend = True)\n",
    "\n",
    "Public_health1.plot(ax = gf, color = 'red', markersize=15)"
   ]
