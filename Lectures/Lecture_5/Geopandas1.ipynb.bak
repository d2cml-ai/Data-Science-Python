   "source": [
    "# Merge using inner way to drop missing values \n",
    "\n",
    "dataset_cv = pd.merge(maps, cv_data, how=\"inner\", on=\"UBIGEO\")\n",
    "dataset_cv"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 260,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to filter dataset_covid by year, month and administrative space(province)\n",
    "\n",
    "def subdata( a , b, c ):\n",
    "    \n",
    "    if c == \"All-Peru\":\n",
    "        \n",
    "        resultado = dataset_cv.loc[(dataset_cv['Año']== a) & (dataset_cv['Mes']== b)]\n",
    "    else:\n",
    "        resultado = dataset_cv.loc[(dataset_cv['Año']== a) & (dataset_cv['Mes']== b) & (dataset_cv['Provincia']== c)]\n",
    "    return resultado  \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 261,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Second wave \n",
    "base = subdata( 2020 , 8, \"All-Peru\")  # all peru Aug-2020\n",
    "\n",
    "#Second wave\n",
    "base_lima = subdata( 2020 , 8, \"LIMA\")  # Lima Aug-2020"
   ]
  },
