    "# DataFrame to GeoDataFrame\n",
    "\n",
    "Public_health = gpd.GeoDataFrame( health_centers, geometry=gpd.points_from_xy( health_centers.NORTE, health_centers.ESTE ) )\n",
    "Public_health.head( 5 )"
   ]
