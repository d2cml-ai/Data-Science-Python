     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, ax = plt.subplots( figsize = ( 12, 15 ) )\n",
    "dist_shp.plot( ax = ax )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "metadata": {},
