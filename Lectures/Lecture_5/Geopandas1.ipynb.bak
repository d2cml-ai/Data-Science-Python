    "dpt_shp.plot( ax = ax )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Checking CRS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 83,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Border of Switzerland\n",
    "ch_borders = gpd.read_file( r'../_data/eu_maps/CHE_adm0.shp')\n",
    "\n",
    "# Border of Germany\n",
    "de_borders = gpd.read_file( r'../_data/eu_maps/gadm36_DEU_0.shp')\n",
    "\n",
    "# Switzerland lakes shape files\n",
    "ch_lakes = gpd.GeoDataFrame.from_file( r'../_data/eu_maps/g2s15.shp')\n",
    "\n",
    "# muni\n",
    "Geo_muni = gpd.read_file( r\"../_data/eu_maps/VG250_GEM.shp\" )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Plots with different CRS"
   ]
  },
  {
   "cell_type": "code",
